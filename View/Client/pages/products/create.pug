extends ../../layouts/default.pug

block main
  .row.justify-content-center
    .col-md-6
      h1.fw-bold.mb-4 Thêm mới sản phẩm
      .card.p-4
        form(action="/products/add", method="POST")
          .mb-3
            label.form-label Tên sản phẩm
            input.form-control(type="text", name="title", required)
          .mb-3
            label.form-label Giá (VNĐ)
            input.form-control(type="number", name="price", required)
          .mb-3
            label.form-label Mô tả
            textarea.form-control(name="description", rows="3")
          .mb-3
            label.form-label Link ảnh (Thumbnail)
            input.form-control(type="text", name="thumbnail")
          .mb-3
            label.form-label Danh mục
            input.form-control(type="text", name="category")
          .d-grid.gap-2
            button.btn.btn-primary(type="submit") Lưu sản phẩm
            a.btn.btn-outline-secondary(href="/products") Hủy
