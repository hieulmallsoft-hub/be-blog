extends ../../layouts/default.pug

block main
  .row.justify-content-center
    .col-md-8
      nav(aria-label="breadcrumb")
        ol.breadcrumb
          li.breadcrumb-item
            a(href="/products") Sản phẩm
          li.breadcrumb-item.active(aria-current="page") Chi tiết

      if product
        .card.p-4
          .row
            .col-md-6
              if product.thumbnail
                img.img-fluid.rounded(src=product.thumbnail, alt=product.title)
              else
                .bg-light.d-flex.align-items-center.justify-content-center.rounded(style="height: 300px;")
                  span.text-muted No Image
            .col-md-6
              h2.fw-bold.mb-3 #{product.title}
              h3.text-primary.mb-4 #{product.price.toLocaleString()} VNĐ
              .mb-4
                h5.fw-bold Mô tả
                p.text-muted #{product.description}

              
              if product.category
                .mb-4
                  span.badge.bg-info.text-dark #{product.category}
              
              .d-flex.gap-2
                button.btn.btn-warning Sửa
                button.btn.btn-danger Xóa
      else
        .alert.alert-danger Không tìm thấy thông tin sản phẩm.
        a.btn.btn-secondary(href="/products") Quay lại danh sách
