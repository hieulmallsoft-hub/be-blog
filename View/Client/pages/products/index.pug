extends ../../layouts/default.pug

block main 
  .d-flex.justify-content-between.align-items-center.mb-4
    h1.fw-bold Danh sách sản phẩm
    a.btn.btn-success(href="/products/create") + Thêm mới

  if products && products.length > 0
    .row.g-4
      each product in products
        .col-md-4.col-sm-6
          .card.h-100
            if product.thumbnail
              img.card-img-top(src=product.thumbnail, alt=product.title style="height: 200px; object-fit: cover;")
            else
              .bg-light.d-flex.align-items-center.justify-content-center(style="height: 200px;")
                span.text-muted No Image
            .card-body
              h5.card-title #{product.title}
              p.card-text.text-primary.fw-bold #{product.price.toLocaleString()} VNĐ
              p.card-text.text-truncate.small #{product.description}
              .d-flex.gap-2
                a.btn.btn-outline-primary.btn-sm.flex-fill(href=`/products/detail/${product.id}`) Chi tiết
                a.btn.btn-outline-warning.btn-sm.flex-fill(href=`/products/edit/${product.id}`) Sửa
                a.btn.btn-outline-danger.btn-sm.flex-fill(href=`/products/delete/${product.id}`, onclick="return confirm('Bạn có chắc muốn xóa?')") Xóa


  else
    .text-center.py-5
      .alert.alert-info Chưa có sản phẩm nào trong cơ sở dữ liệu.